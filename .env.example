# Copy into Vercel → Project → Settings → Environment Variables.
# Each feature switches on when its keys are present; the site works as a demo without them.

# Signs access tokens. Any long random string (e.g. run: openssl rand -hex 32)
TOKEN_SECRET=

# Real AI verdicts (console.anthropic.com). Set a monthly spend limit there.
ANTHROPIC_API_KEY=
# Optional overrides
# VERDICT_MODEL=claude-opus-5-5        # paid checks, with web search
# VERDICT_MODEL_FREE=claude-haiku-5-5  # the free check
# PASS_DAILY_LIMIT=40

# Key-value store for the free-check limit, single-use checks and the email list.
# Add Upstash Redis from the Vercel Marketplace and these are filled in for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Ziina payments (Ziina dashboard → Developers → API key with payment intent permissions)
ZIINA_API_KEY=
# ZIINA_TEST=true                      # test mode: no real money moves
# PRICE_CURRENCY=AED
# PRICE_SINGLE=2600                    # in fils: 26 AED ≈ $7
# PRICE_PASS=5500                      # in fils: 55 AED ≈ $15

# Your live address, used for payment return links and the sitemap
SITE_URL=

# Affiliate link on the cheaper alternative (Amazon Associates tracking id)
AMAZON_TAG=
# AMAZON_DOMAIN=www.amazon.ae

# Optional: also send new emails to a form or newsletter endpoint that accepts JSON
# FORM_ENDPOINT=
